{
  "layer": "top",
  "position": "bottom",
  "height": 20,
  "spacing": 6,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap",
    "hyprland/window"
  ],
  "modules-right": [
    "mpris",
    "pulseaudio",
    "network#wifi",
    "network#ethernet",
    "bluetooth",
    "custom/cpu_temp",
    "custom/cpu_fan",
    "custom/gpu_temp",
    "custom/gpu_fan",
    "custom/hotspot_status",
    "battery",
    "clock",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "format": "{name}",
    "all-outputs": true
  },
  "hyprland/submap": {
    "format": "{}"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 60
  },
  "mpris": {
    "format": "{status_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "format-stopped": "",
    "dynamic-len": 40,
    "interval": 1,
    "tooltip": false,
    "player-icons": {
      "default": "M"
    },
    "status-icons": {
      "playing": "",
      "paused": "",
      "stopped": ""
    }
  },
  "pulseaudio": {
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 2,
    "on-click": "pidof wiremix >/dev/null || hyprctl dispatch exec \"[float; size (monitor_w*0.9) (monitor_h*0.9); center] kitty -e wiremix\"",
    "on-click-right": "kitty wiremix",
    "tooltip": false
  },
  "network#wifi": {
    "interface": "wl*",
    "format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "on-click": "pidof wlctl >/dev/null || hyprctl dispatch exec \"[float; size (monitor_w*0.9) (monitor_h*0.9); center] kitty -e wlctl\""
  },
  "network#ethernet": {
    "interface": "en*",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "on-click": "pidof nmtui >/dev/null || hyprctl dispatch exec \"[float; size (monitor_w*0.9) (monitor_h*0.9); center] kitty -e nmtui\""
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {device_alias}",
    "on-click": "pidof bluetui >/dev/null || hyprctl dispatch exec \"[float; size (monitor_w*0.9) (monitor_h*0.9); center] kitty -e bluetui\""
  },
  "custom/cpu_temp": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/cpu_temp.sh",
    "interval": 2,
    "tooltip": false
  },
  "custom/gpu_temp": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/gpu_temp.sh",
    "interval": 5,
    "tooltip": false
  },
  "custom/cpu_fan": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/cpu_fan.sh",
    "interval": 2,
    "tooltip": false
  },
  "custom/gpu_fan": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/gpu_fan.sh",
    "interval": 2,
    "tooltip": false
  },
  "custom/hotspot_status": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/hotspot_status.sh",
    "interval": 2,
    "on-click": "nm-connection-editor",
    "tooltip": false
  },
  "clock": {
    "format": "{:%H:%M:%S  %d-%m-%Y}",
    "interval": 1,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y-%m-%d}"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-full": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "custom/power": {
    "format": " ",
    "tooltip": false,
    "on-click": "wlogout"
  }
}
