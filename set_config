#!/bin/bash
SOURCE="$(dirname "$0")"
DEST="$HOME/.config"
ZSH_CUSTOM_DIR="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

# Find next backup number
BACKUP_NUM=0
while [ -d "$DEST.bak.$BACKUP_NUM" ]; do
  ((BACKUP_NUM++))
done
BACKUP_DIR="$DEST.bak.$BACKUP_NUM"

echo "Backing up $DEST to $BACKUP_DIR"
cp -r "$DEST" "$BACKUP_DIR"
echo "✓ Backup complete"
echo ""

echo "Copying from repo to $DEST and $ZSH_CUSTOM_DIR"

for item in "$SOURCE"/*; do
  basename_item=$(basename "$item")
  if [ -d "$item" ] && [ "$basename_item" != "get_config" ] && [ "$basename_item" != "set_config" ] && [ "$basename_item" != "diff_config" ] && [ "$basename_item" != ".git" ]; then
    echo -e "  \033[32m→ $basename_item\033[0m"
    cp -rv "$item" "$DEST" | sed 's/^/    /'
  fi
done

# Greeter files: copied out of $HOME because the greeter runs as the `greeter`
# system user, which cannot traverse this 0700 home directory.
if command -v hyprlogin >/dev/null 2>&1; then
  echo -e "  \033[32m→ greeter\033[0m"
  sudo install -Dvm644 "$SOURCE/hypr/hyprlock-theme.conf" /etc/hyprlogin/hyprlock-theme.conf | sed 's/^/    /'
  sudo install -Dvm644 "$SOURCE/hypr/hyprlogin.conf" /etc/hyprlogin/hyprlogin.conf | sed 's/^/    /'
  sudo install -Dvm644 "$SOURCE/hypr/hyprland-greeter.lua" /etc/hyprlogin/hyprland-greeter.lua | sed 's/^/    /'
  sudo install -Dvm644 "$SOURCE/hypr/greetd-config.toml" /etc/greetd/config.toml | sed 's/^/    /'

  # follow whatever hyprlock.conf currently points at
  WALLPAPER=$(sed -n 's/^[[:space:]]*\$wallpaper[[:space:]]*=[[:space:]]*//p' \
    "$SOURCE/hypr/hyprlock.conf" | tail -n1 | sed 's/[[:space:]]*#.*$//; s/[[:space:]]*$//')
  WALLPAPER="${WALLPAPER/#\~/$HOME}"
  WALLPAPER="${WALLPAPER/#\$HOME/$HOME}"

  if [ -r "$WALLPAPER" ]; then
    sudo install -Dvm644 "$WALLPAPER" /usr/share/hyprlogin/wallpaper | sed 's/^/    /'
  else
    echo -e "  \033[31m⊘ wallpaper (not readable: $WALLPAPER)\033[0m"
  fi
else
  echo -e "  \033[31m⊘ greeter (hyprlogin not installed)\033[0m"
fi

# Colour schemes: the caelestia CLI only reads schemes from its own data dir,
# so install ours there. Ask the CLI's interpreter for the dir so this survives
# Python version bumps.
if command -v caelestia >/dev/null 2>&1; then
  CLI_PYTHON=$(head -n1 "$(command -v caelestia)" | sed 's/^#![[:space:]]*//')
  SCHEME_DIR=$($CLI_PYTHON -I -c 'from caelestia.utils.paths import scheme_data_dir; print(scheme_data_dir)' 2>/dev/null)

  if [ -n "$SCHEME_DIR" ]; then
    for scheme in "$SOURCE"/caelestia/schemes/*/; do
      [ -d "$scheme" ] || continue
      echo -e "  \033[32m→ scheme $(basename "$scheme")\033[0m"
      (cd "$scheme" && find . -type f -name '*.txt' -exec sudo install -Dvm644 {} "$SCHEME_DIR/$(basename "$scheme")/{}" \;) | sed 's/^/    /'
    done
  else
    echo -e "  \033[31m⊘ schemes (could not locate the caelestia CLI scheme dir)\033[0m"
  fi
else
  echo -e "  \033[31m⊘ schemes (caelestia CLI not installed)\033[0m"
fi

# Sync all .zsh files from repo to custom dir
for zsh_file in "$SOURCE"/*.zsh; do
  [ -e "$zsh_file" ] || continue
  basename_zsh=$(basename "$zsh_file")
  if [ -f "$ZSH_CUSTOM_DIR/$basename_zsh" ]; then
    echo "  Backing up existing $basename_zsh"
    cp "$ZSH_CUSTOM_DIR/$basename_zsh" "$ZSH_CUSTOM_DIR/$basename_zsh.bak"
  fi
  echo -e "  \033[32m→ $basename_zsh\033[0m"
  cp "$zsh_file" "$ZSH_CUSTOM_DIR/$basename_zsh"
done

echo "Done"
