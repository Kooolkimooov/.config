general {
        colors = true
        interval = 1
}

order += "volume master"
order += "disk /"
order += "ethernet _first_"
order += "tztime local"

volume master {
    format = "%volume"
    format_muted = "muted: %volume"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

disk / {
    format= "%free/%total"
    threshold_type="percentage_free"
    low_threshold=10
}

ethernet _first_ {
    format_up = "%ip (%speed)"
    format_down = "sadge its down"
}

tztime local {
    format = "%a %d %b %Y, %H:%M:%S"
}
