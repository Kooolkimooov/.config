#!/bin/bash
REPO="$(dirname "$0")"
SOURCE="$HOME/.config"
ZSH_CUSTOM_DIR="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

echo "Comparing $REPO with $SOURCE and $ZSH_CUSTOM_DIR"

for item in "$REPO"/*; do
  basename_item=$(basename "$item")
  if [ -d "$item" ] && [ "$basename_item" != ".git" ] && [ "$basename_item" != "get_config" ] && [ "$basename_item" != "set_config" ] && [ "$basename_item" != "diff_config" ]; then
    diff -U5 -r "$item" "$SOURCE/$basename_item" 2>/dev/null | sed -e "s/^-/$(printf '\033')[32m-/; s/^+/$(printf '\033')[34m+/; s/$/$(printf '\033')[0m/"
  fi
done

# Diff all .zsh files
for zsh_file in "$REPO"/*.zsh; do
  [ -e "$zsh_file" ] || continue
  basename_zsh=$(basename "$zsh_file")
  if [ -f "$ZSH_CUSTOM_DIR/$basename_zsh" ]; then
    diff -U5 "$zsh_file" "$ZSH_CUSTOM_DIR/$basename_zsh" 2>/dev/null | sed -e "s/^-/$(printf '\033')[32m-/; s/^+/$(printf '\033')[34m+/; s/$/$(printf '\033')[0m/"
  else
    echo "Only in $REPO: $basename_zsh"
  fi
done

for zsh_file in "$ZSH_CUSTOM_DIR"/*.zsh; do
  [ -e "$zsh_file" ] || continue
  basename_zsh=$(basename "$zsh_file")
  if [ ! -f "$REPO/$basename_zsh" ]; then
    echo "Only in $ZSH_CUSTOM_DIR: $basename_zsh"
  fi
done
